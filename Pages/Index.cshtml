@page
@model BrowsingTestApp.Pages.IndexModel

@{
    ViewData["Title"] = "Products";
}

<h1>Products</h1>

@if (Model.Products.Count == 0)
{
    <p>No products found.</p>
}
else
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>ID</th>
                <th>Product Name</th>
                <th>Price</th>
                <th>Stock</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model.Products)
            {
                <tr>
                    <td>@product.Id</td>
                    <td>@product.Name</td>
                    <td>@product.Price.ToString("N2")</td>
                    <td>@product.Stock</td>
                </tr>
            }
        </tbody>
    </table>
}